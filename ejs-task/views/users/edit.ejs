<%- include('../partials/headers') %>
    <h2>Edit User</h2>

    <form action="/api/edit/<%=user.id%>" method="POST">
        <label>Name</label>
        <input type="text" name="name" placeholder="Enter name" value="<%=user.name%>" required/>

        <label>Email</label>
        <input type="text" name="email" placeholder="email" value="<%=user.email%>" required/>

        <button class="btn">Update</button>
        <a href="/users/list"><button class="btn">Back</button></a>

    </form>
<%- include('../partials/footer') %>