<%- include('../partials/headers') %> 

<div id="list-session">
  <div class="users">
    <% users.forEach((user) => { %>
    <div class="user">
      <ul style="list-style-type: none">
        <li><%=user.id%></li>
        <li><%=user.name%></li>
        <li><%=user.email%></li>
      </ul>
      <div class="btns">
        <button
          class="btn" id="update-btn" onclick="openUpdatePage('<%=user.id%>')">Update</button>
        <button
          class="btn" onclick="openDeletePage('<%=user.id%>')">Delete</button>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<div id="update-model"></div>

<br>
<a href="/auth/logout"><button class="btn">Logout</button></a>

<script src="/index.js"></script>
<%- include('../partials/footer') %>
