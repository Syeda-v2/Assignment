<%- include('../partials/headers') %>

    <% if (success_msg.length > 0) { %>
        <div style="color: green;"><%= success_msg %></div>
    <% } %>

    <% if (error_msg.length > 0) { %>
        <div style="color: red;"><%= error_msg %></div>
    <% } %>

<div class="users">
    <% users.forEach((user) => { %>
        <div class="user">
            <ul style="list-style-type: none;">
                <li><%=user.id%></li>
                <li><%=user.name%></li>
                <li><%=user.email%></li>
                
                
            </ul>
            <div class="btns">
                <a href="/api/edit/<%=user.id%>"><button class="btn" id="update-btn">Update</button></a>
                <a href="/api/delete/<%=user.id%>"><button class="btn">Delete</button></a>
            </div>
        </div>
    <% }) %>
</div>

<a href="/auth/logout"><button class="btn">Logout</button></a>

<%- include('../partials/footer') %>